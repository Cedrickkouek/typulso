FROM oven/bun:1.4.1 AS builder
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
RUN bun run build:realtime
RUN bun build scripts/migrate.ts --target=node --packages=external --outfile=dist/migrate.mjs
RUN bun install --frozen-lockfile --production

FROM node:24-bookworm-slim AS realtime
WORKDIR /app
ENV NODE_ENV=production REALTIME_PORT=3001
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/dist ./dist
COPY --from=builder --chown=node:node /app/db/migrations ./db/migrations
COPY --from=builder --chown=node:node /app/package.json ./package.json
USER node
EXPOSE 3001
CMD ["node", "dist/realtime.mjs"]
