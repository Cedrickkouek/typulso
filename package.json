{
  "name": "typulso",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,realtime \"next dev --hostname 127.0.0.1\" \"bun --watch server/index.ts\"",
    "dev:web": "next dev --hostname 127.0.0.1",
    "dev:realtime": "bun --watch server/index.ts",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "build:realtime": "bun build server/index.ts --target=node --packages=external --outfile=dist/realtime.mjs",
    "start": "node .next/standalone/server.js",
    "realtime": "bun server/index.ts",
    "start:realtime": "node dist/realtime.mjs",
    "db:migrate": "bun scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test tests --timeout 15000",
    "test:integration": "INTEGRATION_TEST=1 bun test tests/integration.test.ts tests/backend.database.test.ts --timeout 30000",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run build:realtime",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@node-rs/argon2": "2.2.1",
    "arctic": "3.7.0",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "10.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "@node-rs/argon2",
    "sharp",
    "unrs-resolver"
  ]
}
